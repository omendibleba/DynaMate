import "gaff2.lt"


DMF inherits GAFF2 {

  #  atomId molId atomType charge X Y Z

  write("Data Atoms"){
    $atom:C1 $mol:m @atom:c3 0.0793 1.279 -0.259 -0.427
    $atom:N1 $mol:m @atom:n -0.4948 -0.009 0.111 0.127
    $atom:C2 $mol:m @atom:c3 0.0793 -1.118 -0.799 -0.072
    $atom:C3 $mol:m @atom:c 0.6609 -0.198 1.365 0.67
    $atom:O1 $mol:m @atom:o -0.6041 0.653 2.238 0.78
    $atom:H1 $mol:m @atom:h1 0.0417 1.562 -1.243 -0.044
    $atom:H2 $mol:m @atom:h1 0.0417 1.193 -0.301 -1.517
    $atom:H3 $mol:m @atom:h1 0.0417 2.055 0.464 -0.16
    $atom:H4 $mol:m @atom:h1 0.0417 -2.022 -0.431 0.421
    $atom:H5 $mol:m @atom:h1 0.0417 -0.856 -1.777 0.342
    $atom:H6 $mol:m @atom:h1 0.0417 -1.31 -0.892 -1.145
    $atom:H7 $mol:m @atom:h5 0.0282 -1.229 1.525 1.025
  } # Atoms section

  #  bondId  atomId1 atomId2

  write("Data Bond List") {
    $bond:b1  $atom:C1  $atom:N1
    $bond:b2  $atom:C1  $atom:H1
    $bond:b3  $atom:C1  $atom:H2
    $bond:b4  $atom:C1  $atom:H3
    $bond:b5  $atom:N1  $atom:C2
    $bond:b6  $atom:N1  $atom:C3
    $bond:b7  $atom:C2  $atom:H4
    $bond:b8  $atom:C2  $atom:H5
    $bond:b9  $atom:C2  $atom:H6
    $bond:b10  $atom:C3  $atom:O1
    $bond:b11  $atom:C3  $atom:H7
  } # Bonds section

}  # DMF






# -------- INSTRUCTIONS FOR USING THIS FILE: --------
# So far, we have just defined (one or more) molecular subunits.
# If you want to use these molecule(s) in a simulation, you must instantiate
# copies of them.  To do that you would the "new" command.  For example:
#
# DMF_instance = new DMF
#
# You could either put this command here, or in a separate file.
# (...Such as "system.lt".  In that case remember to use moltemplate's
#  "import" command to import this file beforehand because you must ensure
#  that the molecules in this file are loaded before they are used.)
#
# Note: You can also modify the position and orientation of each copy
# using the .move() and .rot() commands.  (See the moltemplate manual.)
# ---------------------------------------------------
