
## Import the templates

import "IRMOF-1.lt"
import "EtOH.lt"

# Define the number of molecules
molec_1 = new IRMOF-1[1] #.move(0,0,15.5171)
molec_2 = new EtOH[20] #.move(0,0,15.5171)

## Create the box. The box size is in Angstrom
write_once("Data Boundary") {
   0.0  25  xlo xhi
   0.0  25  ylo yhi
   0.0  25  zlo zhi
}

